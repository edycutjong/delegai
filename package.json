{
  "name": "delegai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "lighthouse": "npx lhci autorun",
    "addresses": "npx tsx --env-file=.env.local scripts/show-addresses.ts",
    "verify": "npx tsx --env-file=.env.local scripts/verify-submission.ts"
  },
  "dependencies": {
    "@metamask/smart-accounts-kit": "^1.5.0",
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.49.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "uuid": "^11.1.1"
  }
}
