# ── Core ─────────────────────────────────────────────────────
# Chain ID for Ethereum Sepolia testnet
NEXT_PUBLIC_CHAIN_ID=11155111

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to use mock data without wallet/testnet (recommended for judging)
DELEGAI_DEMO=true
NEXT_PUBLIC_DELEGAI_DEMO=true

# Demo animation speed: "fast" | "normal" | "slow"
DELEGAI_DEMO_SPEED=fast

# ── App URL (required for live chain) ───────────────────────
# Must be the deployed URL — the x402 data-worker calls back into the same app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── MetaMask Smart Accounts (optional — only for live chain) ─
# Get from: Generate with `cast wallet new` or MetaMask export
PRIVATE_KEY_USER=0x-your-user-private-key-here
PRIVATE_KEY_MASTER=0x-your-master-agent-key-here
PRIVATE_KEY_DATA_WORKER=0x-your-data-worker-key-here
PRIVATE_KEY_EXEC_WORKER=0x-your-exec-worker-key-here

# Get from: https://sepolia.etherscan.io/token/0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── 1Shot Relayer (optional — only for live chain) ───────────
# Get from: https://docs.1shotapi.com
ONESHOT_ENDPOINT=https://relayer.1shotapi.com/relayers

# ── x402 Facilitator (optional — only for live chain) ────────
# Get from: https://docs.x402.org
X402_FACILITATOR=https://facilitator.metamask.io
