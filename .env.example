# ── Core ─────────────────────────────────────────────────────
# Chain ID for Ethereum Sepolia testnet
NEXT_PUBLIC_CHAIN_ID=11155111

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to use mock data without wallet/testnet (recommended for judging)
DELEGAI_DEMO=true
NEXT_PUBLIC_DELEGAI_DEMO=true

# Demo animation speed: "fast" | "normal" | "slow"
DELEGAI_DEMO_SPEED=fast

# ── App URL (required for live chain) ───────────────────────
# Must be the deployed URL — the x402 data-worker calls back into the same app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ── RPC (optional — only for live chain) ────────────────────
# Defaults to public Sepolia node if unset; set for reliability.
#
# How to get (Alchemy — free tier):
#   1. Sign up at https://dashboard.alchemy.com/signup
#   2. Create a new app → Network: "Ethereum Sepolia"
#   3. Copy the HTTPS URL from the app dashboard
#
# Alternatives:
#   - Infura: https://app.infura.io → Create Key → Sepolia endpoint
#   - Ankr:   https://www.ankr.com/rpc/eth → Sepolia (no signup needed)
#   - Public: https://rpc.sepolia.org (rate-limited, not recommended)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key-here

# ── MetaMask Smart Accounts (optional — only for live chain) ─
# Get from: Generate with `cast wallet new` or MetaMask export
PRIVATE_KEY_USER=0x-your-user-private-key-here
PRIVATE_KEY_MASTER=0x-your-master-agent-key-here
PRIVATE_KEY_DATA_WORKER=0x-your-data-worker-key-here
PRIVATE_KEY_EXEC_WORKER=0x-your-exec-worker-key-here

# ── USDC Token Address ────────────────────────────────────────
# Two options:
#
# Option A — "Demo USDC" (recommended for demo mode):
#   A custom mintable ERC-20 deployed for testing. No faucet needed.
#   You control minting, so test wallets can be funded instantly.
#   USDC_ADDRESS=0xf8B331F61902c36a506A4CcF700C6877d55a376A
#
# Option B — Official Circle Sepolia USDC (for live chain testing):
#   Real USDC testnet token issued by Circle.
#   Get test USDC from: https://faucet.circle.com/ (requires login)
#   Verify at: https://sepolia.etherscan.io/token/0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
#   USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── 1Shot Relay (optional — only for live chain) ─────────────
# Create API credentials at https://1shotapi.com → API Keys
ONESHOT_API_KEY=your-api-key-here
ONESHOT_API_SECRET=your-api-secret-here
# Optional: register redeemDelegations as a Contract Method in 1Shot dashboard
# Without this, fee data works but transaction submission degrades gracefully.
ONESHOT_CONTRACT_METHOD_ID=your-contract-method-uuid-here

# ── Venice AI (optional — agent LLM reasoning) ───────────────
# Get from: https://venice.ai/settings/api → Create API Key
# Without this, agents fall back to pre-scripted demo reasoning strings.
VENICE_API_KEY=your-venice-api-key-here
# Model to use — defaults to llama-3.3-70b if unset
# VENICE_MODEL=llama-3.3-70b

# ── x402 Facilitator (optional — only for live chain) ────────
# Get from: https://docs.x402.org
X402_FACILITATOR=https://facilitator.metamask.io
